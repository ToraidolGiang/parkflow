# Sao chép thành .env và điền giá trị. KHÔNG commit .env.
TZ=Asia/Ho_Chi_Minh

# Database (Postgres)
DB_URL=jdbc:postgresql://localhost:5432/parkflow
DB_USER=parkflow
DB_PASSWORD=parkflow

# Ingest API: key của nhà cung cấp / trình giả lập (header X-Api-Key). Để trống khi chạy dev.
EVENTS_API_KEY=

# Trợ lý AI (chỉ cần khi làm phần AI; để trống thì dùng dữ liệu mẫu). KHÔNG commit khóa thật.
GEMINI_API_KEY=
GROQ_API_KEY=

# Khóa điều khiển bắt đầu/dừng giả lập (header X-Api-Key).
SIM_CONTROL_KEY=
