# Ảnh web: dựng giao diện React rồi để Caddy phát file tĩnh và chuyển /api/* sang backend.
# Dựng từ GỐC repo: docker build -f deploy/Dockerfile.web .
FROM node:22 AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/frontend/dist /srv
