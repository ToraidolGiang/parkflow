# Sao chép thành deploy/.env.prod (tệp này đã bị .gitignore) và điền giá trị. KHÔNG commit .env.prod.
DB_PASSWORD=
# Khóa nhà cung cấp gửi sự kiện (header X-Api-Key); để trống thì không chặn.
EVENTS_API_KEY=
# Khóa điều khiển giả lập (bắt đầu/dừng/đột biến); để trống thì không điều khiển được.
SIM_CONTROL_KEY=
# Khóa trợ lý AI; để trống thì dùng dữ liệu mẫu.
GROQ_API_KEY=
GEMINI_API_KEY=
AI_MOCK=false
# Tên miền (HTTPS tự cấp) hoặc :80 cho chạy thử bằng HTTP.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Chạy song song cạnh một dịch vụ khác đang giữ cổng 80/443: chỉ nghe trong máy (127.0.0.1) ở cổng phụ,
# rồi cho dịch vụ đang giữ cổng 80/443 chuyển một tên miền về 127.0.0.1:8081.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8081
# HTTPS_PORT=8444
